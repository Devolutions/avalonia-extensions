<!-- TreeDataGrid theme aligned to DataGrid naming/brushes -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters">

  <!-- Theme dictionaries reuse DataGrid brush keys so both controls
       draw from the same palette -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <!-- Use the SAME keys your DataGrid theme uses -->
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="{DynamicResource SystemAltMediumColor}" />
      <SolidColorBrush x:Key="DataGridRowInvalidBrush" Color="{DynamicResource SystemErrorTextColor}" />
      <SolidColorBrush x:Key="DataGridCellInvalidBrush" Color="{DynamicResource SystemErrorTextColor}" />
      <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="{DynamicResource SystemChromeMediumLowColor}" />

      <!-- Header hover/pressed using your system colors -->
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPressedBrush" Color="{DynamicResource SystemBaseMediumLowColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPressedBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPointerOverBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPressedBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <StaticResource x:Key="TreeDataGridHeaderForegroundBrush" ResourceKey="ForegroundHighBrush" />
      
      <SolidColorBrush x:Key="TreeDataGridSelectedRowBackgroundBrush" Color="#cde8ff" />
      <SolidColorBrush x:Key="TreeDataGridAlternatingRowBackground" Color="#f2f6fb" />

      <SolidColorBrush x:Key="TreeDataGridInnerGridBrush" Color="#dadada" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="{DynamicResource SystemAltMediumColor}" />
      <SolidColorBrush x:Key="DataGridRowInvalidBrush" Color="{DynamicResource SystemErrorTextColor}" />
      <SolidColorBrush x:Key="DataGridCellInvalidBrush" Color="{DynamicResource SystemErrorTextColor}" />
      <SolidColorBrush x:Key="DataGridDetailsPresenterBackgroundBrush" Color="{DynamicResource SystemChromeMediumLowColor}" />

      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" Color="{DynamicResource SystemBaseHighColor}" Opacity="0.1" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBackgroundPressedBrush" Color="{DynamicResource SystemBaseMediumLowColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderBorderBrushPressedBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPointerOverBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="TreeDataGridHeaderForegroundPressedBrush" Color="{DynamicResource SystemBaseHighColor}" />
      <StaticResource x:Key="TreeDataGridHeaderForegroundBrush" ResourceKey="ForegroundHighBrush" />

      <SolidColorBrush x:Key="TreeDataGridSelectedRowBackgroundBrush" Color="#3c3c3c" />
      <SolidColorBrush x:Key="TreeDataGridAlternatingRowBackground" Color="#292a2c" />

      <SolidColorBrush x:Key="TreeDataGridInnerGridBrush" Color="#404040" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="TreeDataGridHeaderHeight">27</x:Double>
  <x:Double x:Key="TreeDataGridRowHeight">25</x:Double>
  <SolidColorBrush x:Key="TreeDataGridHeaderBackground" Color="{DynamicResource SystemRegionColor}" />
  <SolidColorBrush x:Key="TreeDataGridSelectedRowBackgroundAccentBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
  <StaticResource x:Key="DataGridCurrencyVisualPrimaryBrush" ResourceKey="SystemControlTransparentBrush" />
  <StaticResource x:Key="DataGridFillerColumnGridLinesBrush" ResourceKey="SystemControlTransparentBrush" />

  <!-- Sort/chevron geometry -->
  <StreamGeometry x:Key="TreeDataGridItemCollapsedChevronPathData">M 0,0 L 5,5 L 0,10 L 1,10 L 6,5 L 1,0 Z</StreamGeometry>
  <StreamGeometry x:Key="TreeDataGridItemExpandedChevronPathData">M 0,0 L 5,5 L 10,0 L 10,1 L 5,6 L 0,1 Z</StreamGeometry>
  <StreamGeometry x:Key="TreeDataGridSortIconPath">M 0,0 H 1855.86 V 167.17 H 0 Z M 337.18,507 H 1518.54 V 674.17 H 337.18 Z M 673.74,1013 H 1181.97 V 1180.17 H 673.74 Z</StreamGeometry>

  <ControlTheme x:Key="{x:Type TreeDataGrid}" TargetType="TreeDataGrid">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundHighBrush}" />
    <Setter Property="TreeDataGridPseudoTypeBehavior.Enable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!--
                        Note: This double-border trick is for fixing clipping issue with rounded corners.
                              remove once this issue is fixed: 
                              https://github.com/AvaloniaUI/Avalonia/issues/2105
                              - sbergerondrouin 2026/01/29 
                    -->
          <Border Name="DataGridBorder"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False"
                  ZIndex="999" />

          <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True" BorderThickness="0" ZIndex="1">
            <Grid RowDefinitions="Auto,*"
                  ZIndex="2"
                  Background="{TemplateBinding Background}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="1" />
              </Grid.ColumnDefinitions>

              <!-- Column headers: add bottom grid line -->
              <ScrollViewer Name="PART_HeaderScrollViewer"
                            Grid.Row="0"
                            Grid.Column="0"
                            IsVisible="{TemplateBinding ShowColumnHeaders}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                <Border Name="ColumnHeadersPresenterBorder"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource TreeDataGridInnerGridBrush}"
                        Background="{DynamicResource TreeDataGridHeaderBackground}"
                        CornerRadius="{TemplateBinding CornerRadius,
                                            Converter={x:Static DevoConverters.CornerRadiusExtractor},
                                            ConverterParameter={x:Static CornerRadiusSubset.Top}
                                        }">
                  <TreeDataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter"
                                                      ElementFactory="{TemplateBinding ElementFactory}"
                                                      Items="{TemplateBinding Columns}"
                                                      ItemContainerTheme="{TemplateBinding ColumnHeaderTheme}" />
                </Border>
              </ScrollViewer>
              <Border Grid.Row="0"
                      Grid.Column="1"
                      Background="{DynamicResource TreeDataGridHeaderBackground}"
                      BorderBrush="{DynamicResource TreeDataGridInnerGridBrush}"
                      BorderThickness="0 0 0 1"/>
              <ScrollBar Grid.Row="0"
                         Grid.RowSpan="2"
                         Grid.Column="1"
                         Orientation="Vertical"
                          Opacity="0"
                          IsHitTestVisible="False"
                          Focusable="False"
                          Margin="0 0 1 0"
                         IsVisible="{AndBinding 
                            {ScrollBarVisibilityBinding #PART_ScrollViewer, Vertical},
                            {TemplateBinding ShowColumnHeaders}
                         }" />

              <!-- Rows -->
              <ScrollViewer Name="PART_ScrollViewer"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0 0 1 1"
                            AllowAutoHide="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                <TreeDataGridRowsPresenter Name="PART_RowsPresenter"
                                           Columns="{TemplateBinding Columns}"
                                           ElementFactory="{TemplateBinding ElementFactory}"
                                           Items="{TemplateBinding Rows}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeDataGridColumnHeader}" TargetType="TreeDataGridColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource TreeDataGridHeaderForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinHeight" Value="{StaticResource TreeDataGridHeaderHeight}" />
    <!-- Trailing 6 is the caption's gutter before the column separator. It lives in Padding rather than in
         a Margin on HeaderContent: both reserve the same 6px and both count toward the header's desired
         width, but a Margin also shrinks HeaderContent's own bounds, which kept a header adornment 6px off
         the header's right edge. Padding insets only the caption. -->
    <Setter Property="Padding" Value="0 0 6 0" />
    <Setter Property="BorderBrush" Value="{DynamicResource TreeDataGridInnerGridBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False" ZIndex="9">
          <!-- hit-target, for the column itself, offset to the left for the Thumb overflow).
               Comes FIRST so interactive header content sits above it and wins the click; anything not
               handled there bubbles to the TreeDataGridColumnHeader, which performs the sort. -->
          <Border Background="Transparent" Margin="6 0 0 0" />

          <!-- Stays inert: it spans the full width, so making it hit-testable would cover the 6px lane
               the previous column's resize thumb overhangs into. -->
          <Border Name="HeaderBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="False"
                  IsHitTestVisible="False">
            <Panel VerticalAlignment="Stretch" ClipToBounds="False">
              <!-- Sort icon (reusing DataGrid foreground). Shifted left by the header adornment's width so a
                   Right-positioned adornment sits beside it, and hidden while the adornment fills the
                   header, where the two would otherwise overlap.

                   Collapsing this panel does drop a few px from the header's own desired width, since it
                   sits in the measured tree. That cannot move a column: the icon footprint is smaller than
                   TreeDataGrid's minimum column width, which wins at those sizes, and any caption wide
                   enough to beat that minimum already outmeasures the icon. Pinned by
                   PositionChange_DoesNotResizeAnEmptyAutoColumn. -->
              <Panel HorizontalAlignment="Right"
                     VerticalAlignment="Stretch"
                     IsVisible="{Binding #HeaderContent.AdornmentPosition, Converter={x:Static DevoConverters.IsOneOfConverter}, ConverterParameter=Right}">
                <Panel.RenderTransform>
                  <TranslateTransform X="{MultiplyBinding {Binding #HeaderContent.AdornmentWidth}, -1}" />
                </Panel.RenderTransform>
                <Path Name="SortIcon"
                      Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="-6 0 3 0"
                      Stretch="Uniform"
                      Width="12"
                      Height="7"
                      TabIndex="-1"
                      IsTabStop="False"
                      Opacity="0"
                      Data="{StaticResource TreeDataGridSortIconPath}" />
              </Panel>
            </Panel>
          </Border>

          <!-- Header content, a sibling of HeaderBorder rather than its child so it can be interactive
               without the full-width border becoming so. The leading 6 stays in InnerContentMargin rather
               than moving to Margin: InnerContentMargin is excluded from the desired size, so moving it
               would widen every column by 6px. -->
          <TreeDataGridOverflowHeader Name="HeaderContent"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      InnerContentMargin="{BindingToggler
                                        {Binding $parent[TreeDataGridColumnHeader].SortDirection, Converter={x:Static ObjectConverters.IsNotNull}},
                                        6 0 12 0,
                                        6 0 0 0
                                      }"
                                      TextTrimming="CharacterEllipsis"
                                      ShowToolTip="True"
                                      TabIndex="0" />

          <!-- Right separator + resizer -->
          <Panel HorizontalAlignment="Right" TabIndex="2" ClipToBounds="False" Width="5" ZIndex="99">
            <Rectangle Fill="{TemplateBinding BorderBrush}"
                       HorizontalAlignment="Right"
                       ZIndex="999"
                       Width="{TemplateBinding BorderThickness, 
                                           Converter={x:Static DevoConverters.ThicknessNumericExtractor}, 
                                           ConverterParameter={x:Static ThicknessSide.Right}}" />
            <!-- 
              9px would be the proper width to be perfectly-centered.
              HOWEVER, since mouse cursor's arrow tip is usually to the left, it actually "feel"
              better to extend the hitbox more to the right
            -->
            <Thumb Name="PART_Resizer"
                   Background="Transparent"
                   ZIndex="9999"
                   Cursor="SizeWestEast"
                   IsVisible="{TemplateBinding CanUserResize}"
                   HorizontalAlignment="Left"
                   Width="11">
              <Thumb.Template>
                <ControlTemplate>
                  <Border Background="{TemplateBinding Background}" VerticalAlignment="Stretch" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Pointer states, matching your TreeDataGrid defaults -->
    <Style Selector="^:pointerover:not(:pressed) /template/ Border#HeaderBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridHeaderBackgroundPointerOverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TreeDataGridHeaderBorderBrushPointerOverBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TreeDataGridHeaderForegroundPointerOverBrush}" />
      <Setter Property="Path.Fill" Value="{DynamicResource TreeDataGridHeaderForegroundPointerOverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#HeaderBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridHeaderBackgroundPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TreeDataGridHeaderBorderBrushPressedBrush}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TreeDataGridHeaderForegroundPressedBrush}" />
      <Setter Property="Path.Fill" Value="{DynamicResource TreeDataGridHeaderForegroundPressedBrush}" />
    </Style>

    <!-- The caption is a sibling of HeaderBorder, so it no longer inherits that border's
         TextBlock.Foreground and needs the pointer states applied directly. -->
    <Style Selector="^:pointerover:not(:pressed) /template/ TreeDataGridOverflowHeader#HeaderContent">
      <Setter Property="Foreground" Value="{DynamicResource TreeDataGridHeaderForegroundPointerOverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ TreeDataGridOverflowHeader#HeaderContent">
      <Setter Property="Foreground" Value="{DynamicResource TreeDataGridHeaderForegroundPressedBrush}" />
    </Style>

    <!-- Sort Adorners -->
    <Style Selector="^[SortDirection=Ascending] /template/ Path#SortIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scaleY(-1)" />
    </Style>
    <Style Selector="^[SortDirection=Descending] /template/ Path#SortIcon">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeDataGridRow}" TargetType="TreeDataGridRow">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="{StaticResource TreeDataGridRowHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="RowBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <!-- Invalid overlay like DataGrid -->
            <Rectangle Name="InvalidVisualElement"
                       Opacity="0"
                       Fill="{DynamicResource DataGridRowInvalidBrush}" />
            <TreeDataGridCellsPresenter Name="PART_CellsPresenter"
                                        ElementFactory="{TemplateBinding ElementFactory}"
                                        Items="{TemplateBinding Columns}"
                                        Rows="{TemplateBinding Rows}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#RowBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridSelectedRowBackgroundBrush}" />
    </Style>

    <Style Selector="^:invalid /template/ Rectangle#InvalidVisualElement">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <!-- Cells -->
  <ControlTheme x:Key="{x:Type TreeDataGridTextCell}" TargetType="TreeDataGridTextCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6 0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="CellBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <TextBlock Text="{TemplateBinding Value}"
                     TextTrimming="{TemplateBinding TextTrimming}"
                     TextWrapping="{TemplateBinding TextWrapping}"
                     TextAlignment="{TemplateBinding TextAlignment}"
                     VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#CellBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridSelectedRowBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeDataGridTemplateCell}" TargetType="TreeDataGridTemplateCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6 0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridSelectedRowBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeDataGridCheckBoxCell}" TargetType="TreeDataGridCheckBoxCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6 0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="CellBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <CheckBox IsChecked="{TemplateBinding Value, Mode=TwoWay}"
                    IsEnabled="{Binding !IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                    IsThreeState="{TemplateBinding IsThreeState}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#CellBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridSelectedRowBackgroundBrush}" />
    </Style>
  </ControlTheme>

  <!-- Expander: chevron + indent -->
  <ControlTheme x:Key="TreeDataGridExpandCollapseChevron" TargetType="ToggleButton">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="6 0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="{StaticResource TreeDataGridRowHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Path Name="ChevronPath"
                Data="{StaticResource TreeDataGridItemCollapsedChevronPathData}"
                Fill="{TemplateBinding Foreground}"
                Width="6"
                Height="10"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#ChevronPath">
      <Setter Property="Data" Value="{StaticResource TreeDataGridItemExpandedChevronPathData}" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="6" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeDataGridExpanderCell}" TargetType="TreeDataGridExpanderCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="CellBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Indent, Converter={x:Static conv:IndentConverter.Instance}}">
          <DockPanel>
  <Border DockPanel.Dock="Left" Width="22">
              <ToggleButton Theme="{StaticResource TreeDataGridExpandCollapseChevron}"
                            Focusable="False"
                            Width="22"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                            IsVisible="{TemplateBinding ShowExpander}"
                            Margin="0 0 -6 0" />
            </Border>
            <Decorator Name="PART_Content" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#CellBorder">
      <Setter Property="Background" Value="{DynamicResource TreeDataGridSelectedRowBackgroundBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
