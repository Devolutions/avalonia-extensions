<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Stock Fluent/Simple themes don't define LayoutBackgroundLowBrush, which the demo pages use
       for their alternative panels; the Devolutions themes each provide their own. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="LayoutBackgroundLowBrush" Color="#0F000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="LayoutBackgroundLowBrush" Color="#0FFFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
