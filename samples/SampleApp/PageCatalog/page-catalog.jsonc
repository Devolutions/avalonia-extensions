{
  // SampleApp start-up setting options:
  //  - theme: Default or theme name (MacOS, MacOSClassic, MacOSLiquidGlass, DevExpress, Linux, WinUI, WinUiClassic, WinUiMica, Fluent, Simple)
  //           NOTE: Design Preview still requires uncommenting the right theme in App.xaml
  //  - selectedPage: Default or any page title (partial match is allowed)
  //  - scale: Default, 100%, 125%, 150%, 175%, 200%, 225%, 250%, 275%, 300%, 400%
  "sampleAppStartUpSettings": {
    "theme": "Default",
    "selectedPage": "Default",
    "scale": "Default"
  },
  "statusSymbols": {
    "": "No status",
    "✅": "Styled",
    "❌": "Not styled (yet) / not supported",
    "🚧": "In Progress (excluded from visual regression tests)",
    "⚠️": "Needs some work / updates (included in tests)",
    "↔️": "Same as WinUIMica (WinUIClassic column only, set deliberately after review): inherits its status, tested for pixel-identical rendering instead of own baselines"
  },
  // By default, statusSymbols determine test inclusion: "", ❌, and 🚧 are excluded, ✅ and ⚠️
  // are included. Use 🚧 while a control's styling is in flux / unverified; switch to ⚠️
  // once it's stable enough that regressions should be caught, even if not perfect yet.
  // ↔️ is only valid in the WinUIClassic column: it means "renders identically to WinUIMica".
  // The page inherits WinUIMica's status, stores no classic baselines, and is instead tested
  // for pixel-identical output against a WinUIMica render. If a Mica overlay change makes the
  // two diverge, that test fails — then give WinUIClassic its own status and baselines.
  // ↔️ is a deliberate, manual decision — never a default. Only set it once a control is done in
  // WinUIMica AND a review against the WinUI source/docs found nothing that should look different
  // in classic. (The equality test can't catch a Mica-only look wrongly placed in the shared base
  // resources — both variants would then match while being wrong.) Until then, keep WinUIClassic
  // tracking the same status as WinUIMica (e.g. both 🚧).
  // To override this, use "excludeFromTests" to explicitly exclude a control from tests in a specific theme:
  //
  //   "excludeFromTests": {
  //     "Linux": true
  //   }
  //
  "topLevelOrder": [
