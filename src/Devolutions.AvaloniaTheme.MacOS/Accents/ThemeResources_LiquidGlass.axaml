<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 
    Un-comment to allow auto-completion;
    DO NOT INCLUDE WHEN PUBLISHING!
  -->
  <!-- <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="/Accents/ThemeResources.axaml" />
  </ResourceDictionary.MergedDictionaries>       -->

  <!-- MARK: Solid Colours -->

  <Color x:Key="AccentForegroundColor">#ffffff</Color>

  <!-- MARK: Converters -->
  <OklchAdjustmentConverter x:Key="LightModeFocusColorConverter" LightnessAdjustment="-0.03" ChromaAdjustment="0.04" HueAdjustment="7" />
  <OklchAdjustmentConverter x:Key="DarkModeFocusColorConverter" LightnessAdjustment="0.15" ChromaAdjustment="0" HueAdjustment="3" />

  <OklchAdjustmentConverter x:Key="LightModeAccentBackgroundWashConverter" LightnessAdjustment="-0.01" ChromaAdjustment="-0.01" HueAdjustment="5" />
  <OklchAdjustmentConverter x:Key="DarkModeAccentBackgroundWashConverter" LightnessAdjustment="0" ChromaAdjustment="-0.01" HueAdjustment="5.1" />

  <!--
    Selection colour: the accent shifted in lightness only - hue and chroma pass through untouched.
    Nothing more faithful is available. Apple ships hand-picked per-accent constants rather than a
    formula (AppleHighlightColor holds explicit RGB per accent while AppleAccentColor is just an
    index), and macOS draws a menu highlight as an NSVisualEffectMaterial rather than a colour, so
    there is nothing to copy. Measuring Finder across four accents ruled out every simple model:
    constant Oklch/HSL offsets, compositing over any surface in sRGB or linear light, fixed-alpha
    Oklab blending, gamut limiting, and Display P3 blending.

    Fitted against Finder's DROP-DOWN selection for purple, red, green and blue, measured per
    appearance - the drop-down target rather than the menu one because that is where the difference
    shows, and Finder's two differ: its menu selection is lighter, so fitting that made drop-down
    rows read washed out. Mean deviation dE(Oklab) 0.04 light, 0.04 dark.

    Chroma is capped as well as lightness shifted. Judged on mean error the cap looks marginal
    (0.03 against 0.04), but the mean hides where it acts: it does nothing to muted accents and is
    the whole fix for vivid ones. Without it red in dark keeps the accent's chroma of 0.208 against
    native 0.181, which reads as a purer, less orange red, and pink comes out hot. A ceiling also
    leaves a graphite accent grey by construction, since only a chroma *offset* could tint it -
    which is what the previous values did.

    The dark offset is the part that cannot be dropped: native dark selection is far darker than the
    accent, and leaving lightness alone scores dE 0.107 there.

    Opacity is gone, and that is the fix for the washed-out look rather than any constant: at 0.64
    over a near-white popup surface an accent's chroma is diluted toward the surface, so measured
    across four accents the old setup came out lighter AND less chromatic than native every time
    (blue chroma 0.155 against native 0.177). No constant can reach the target through that.

    KNOWN UPSTREAM ISSUE: Avalonia captures SystemAccentColor when the app starts and does not
    refresh it when the macOS appearance changes, so after a light/dark switch these per-variant
    constants are applied to the *previous* appearance's accent until the app restarts. macOS reports
    a different accent per appearance for some accents (red is #E0383E light / #FF5257 dark), so it
    shows on those and not on blue or green. Nothing here can compensate - the input is wrong.
    Tracked at https://support.avaloniaui.net/support/tickets/1857
  -->
  <OklchAdjustmentConverter x:Key="LightModeAccentHighlightConverter" LightnessAdjustment="0.020" ChromaCap="0.175" />
  <OklchAdjustmentConverter x:Key="DarkModeAccentHighlightConverter" LightnessAdjustment="-0.110" ChromaCap="0.180" />

  <!-- MARK: Brushes -->

  <!-- Brush naming scheme: -->
  <!--   Surface = low-opacity Foreground brushes for surfaces (vs. lines and text) -->
  <!--   T = Transparent (with opacity in %) -->
  <!--   H = Highlighted (with ForegroundColor overlay in %) -->
  <!--   D = Dimmed (with BackgroundColor overlay in %) -->

  <SolidColorBrush x:Key="Transparent" Color="Transparent" />

  <SolidColorBrush x:Key="Highlight" Color="{DynamicResource BackgroundColor}" />

  <SolidColorBrush x:Key="SurfaceT03" Color="{DynamicResource ForegroundColor}" Opacity="0.03" />
  <SolidColorBrush x:Key="SurfaceT04" Color="{DynamicResource ForegroundColor}" Opacity="0.04" />
  <SolidColorBrush x:Key="SurfaceT05" Color="{DynamicResource ForegroundColor}" Opacity="0.05" />
  <SolidColorBrush x:Key="SurfaceT07" Color="{DynamicResource ForegroundColor}" Opacity="0.07" />
  <SolidColorBrush x:Key="SurfaceT08" Color="{DynamicResource ForegroundColor}" Opacity="0.08" />
  <SolidColorBrush x:Key="SurfaceT10" Color="{DynamicResource ForegroundColor}" Opacity="0.1" />
  <SolidColorBrush x:Key="SurfaceT13" Color="{DynamicResource ForegroundColor}" Opacity="0.13" />
  <SolidColorBrush x:Key="SurfaceT14" Color="{DynamicResource ForegroundColor}" Opacity="0.14" />
  <SolidColorBrush x:Key="SurfaceT15" Color="{DynamicResource ForegroundColor}" Opacity="0.15" />
  <SolidColorBrush x:Key="SurfaceT16" Color="{DynamicResource ForegroundColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="SurfaceT18" Color="{DynamicResource ForegroundColor}" Opacity="0.18" />
  <SolidColorBrush x:Key="SurfaceT19" Color="{DynamicResource ForegroundColor}" Opacity="0.19" />

  <SolidColorBrush x:Key="ForegroundT20" Color="{DynamicResource ForegroundColor}" Opacity="0.2" />
  <SolidColorBrush x:Key="ForegroundT24" Color="{DynamicResource ForegroundColor}" Opacity="0.24" />
  <SolidColorBrush x:Key="ForegroundT26" Color="{DynamicResource ForegroundColor}" Opacity="0.26" />
  <SolidColorBrush x:Key="ForegroundT50" Color="{DynamicResource ForegroundColor}" Opacity="0.5" />
  <SolidColorBrush x:Key="ForegroundT85" Color="{DynamicResource ForegroundColor}" Opacity="0.85" />

  <SolidColorBrush x:Key="AccentForeground" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="AccentForegroundT25" Color="{DynamicResource AccentForegroundColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="AccentForegroundT49" Color="{DynamicResource AccentForegroundColor}" Opacity="0.49" />
  <SolidColorBrush x:Key="AccentForegroundT51" Color="{DynamicResource AccentForegroundColor}" Opacity="0.51" />
  <SolidColorBrush x:Key="AccentForegroundT84" Color="{DynamicResource AccentForegroundColor}" Opacity="0.84" />

  <SolidColorBrush x:Key="SystemAccent" Color="{DynamicResource SystemAccentColor}" />
  <SolidColorBrush x:Key="SystemAccentT48" Color="{DynamicResource SystemAccentColor}" Opacity="0.48" />

  <VisualBrush x:Key="SystemAccentH10" Stretch="Fill">
    <VisualBrush.Visual>
      <Panel>
        <Rectangle Fill="{StaticResource SystemAccent}" Width="16" Height="16" />
        <Rectangle Fill="{StaticResource SurfaceT10}" Width="16" Height="16" />
      </Panel>
    </VisualBrush.Visual>
  </VisualBrush>

  <VisualBrush x:Key="SystemAccentH13" Stretch="Fill">
    <VisualBrush.Visual>
      <Panel>
        <Rectangle Fill="{StaticResource SystemAccent}" Width="16" Height="16" />
        <Rectangle Fill="{StaticResource SurfaceT13}" Width="16" Height="16" />
      </Panel>
    </VisualBrush.Visual>
  </VisualBrush>

  <VisualBrush x:Key="SystemAccentD03" Stretch="Fill">
    <VisualBrush.Visual>
      <Panel>
        <Rectangle Fill="{StaticResource SystemAccent}" Width="16" Height="16" />
        <Rectangle Fill="{StaticResource SurfaceT03}" Width="16" Height="16" />
      </Panel>
    </VisualBrush.Visual>
  </VisualBrush>

  <VisualBrush x:Key="SystemAccentD04" Stretch="Fill">
    <VisualBrush.Visual>
      <Panel>
        <Rectangle Fill="{StaticResource SystemAccent}" Width="16" Height="16" />
        <Rectangle Fill="{StaticResource SurfaceT04}" Width="16" Height="16" />
      </Panel>
    </VisualBrush.Visual>
  </VisualBrush>

  <!-- MARK: Shadows -->

  <BoxShadows x:Key="NoShadow">0 0 Transparent</BoxShadows>

  <!-- MARK: Thicknesses -->

  <Thickness x:Key="Thickness0">0</Thickness>
  <Thickness x:Key="Thickness1">1</Thickness>
  <Thickness x:Key="ThicknessT1">0 1 0 0</Thickness>
  <Thickness x:Key="ThicknessL12R11">12 0 11 0</Thickness>

  <!-- MARK: Measurements -->

  <x:Double x:Key="ControlSize27">27</x:Double>
  <x:Double x:Key="ControlSize24">24</x:Double>
  <x:Double x:Key="ControlSize16">16</x:Double>
  <x:Double x:Key="ControlSize10">10</x:Double>
  <x:Double x:Key="ControlSize9">9</x:Double>
  <x:Double x:Key="ControlSize5">5</x:Double>
  <x:Double x:Key="ControlSize3">3</x:Double>

  <!-- MARK: Radii -->

  <CornerRadius x:Key="Radius12">12</CornerRadius>
  <CornerRadius x:Key="Radius9">9</CornerRadius>
  <CornerRadius x:Key="Radius8">8</CornerRadius>
  <CornerRadius x:Key="Radius7">7</CornerRadius>
  <CornerRadius x:Key="Radius6">6</CornerRadius>
  <CornerRadius x:Key="Radius5">5</CornerRadius>
  <CornerRadius x:Key="Radius0">0</CornerRadius>


  <!-- Resource naming scheme: -->
  <!-- Class - Control - Control-state - disabled - inactive / Interaction-state - Element - Property / Resource-type -->


  <!-- MARK: Light Mode -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="InputBackgroundColor">#ffffff</Color>

      <!-- OpaqueSurfaceTxx colours are used to fake the look of SurfaceTxx on standard backgrounds when true transparency doesn't work -->
      <SolidColorBrush x:Key="OpaqueSurfaceT07" Color="#ececec" />

      <!--
        Opaque, even though LiquidGlass is translucent elsewhere. Avalonia can only blur a popup's
        backdrop through the window compositor, and that blur cannot be shaped to the popup's
        rounded corners - so a translucent popup shows sharp, legible content straight through it
        instead of the frosted surface AppKit produces. This colour is sampled from a native macOS
        menu sitting over a typical window background, so popups land where AppKit's do without
        needing the blur. Renamed from TranslucentSurface, which no longer describes it.
      -->
      <SolidColorBrush x:Key="PopupSurface" Color="#f8f9f9" />

      <SolidColorBrush x:Key="AccentBackgroundWash" x:DataType="SolidColorBrush"
                       Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource LightModeAccentBackgroundWashConverter}}"
                       Opacity="0.43" />
      <!--
        Opaque. The colour it has to hit cannot be reached through opacity: compositing the light
        target over the popup surface at 0.64 needs a base colour outside sRGB (one channel goes
        negative), so the surface was diluting the selection into something no opacity could fix.
        Opaque makes the rendered colour be the brush colour, which is also what the popup surface
        itself does.
      -->
      <SolidColorBrush x:Key="AccentHighlight" x:DataType="SolidColorBrush"
                       Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource LightModeAccentHighlightConverter}}" />

      <!-- Generic resources shared across controls (use sparingly!) -->

      <SolidColorBrush x:Key="FocusBorderBrush" x:DataType="SolidColorBrush"
                       Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource LightModeFocusColorConverter}}" Opacity="0.49" />
      <StaticResource x:Key="ControlLabelBrush" ResourceKey="ForegroundT85" />
      <StaticResource x:Key="ControlDisabledLabelBrush" ResourceKey="ForegroundT24" />

      <StaticResource x:Key="PopupBackgroundBrush" ResourceKey="PopupSurface" />
      <StaticResource x:Key="PopupInnerBorderHighlightBrush" ResourceKey="Highlight" />

      <!-- Control-specific resources -->

      <StaticResource x:Key="ButtonBackgroundBrush" ResourceKey="SurfaceT07" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ButtonBackgroundBrush" />
      <StaticResource x:Key="ButtonDisabledBackgroundBrush" ResourceKey="SurfaceT04" />
      <StaticResource x:Key="ButtonDisabledBorderBrush" ResourceKey="Transparent" />
      <StaticResource x:Key="ButtonPressedBackgroundBrush" ResourceKey="SurfaceT16" />
      <StaticResource x:Key="AccentButtonBackgroundBrush" ResourceKey="SystemAccent" />
      <StaticResource x:Key="AccentButtonInactiveBackgroundBrush" ResourceKey="ButtonBackgroundBrush" />
      <StaticResource x:Key="AccentButtonPressedBackgroundBrush" ResourceKey="SystemAccentH10" />
      <StaticResource x:Key="AccentButtonDisabledBorderBrush" ResourceKey="ButtonDisabledBorderBrush" />

      <StaticResource x:Key="TabControlTabstripBackgroundBrush" ResourceKey="OpaqueSurfaceT07" />

      <StaticResource x:Key="TabItemOuterBorderThickness" ResourceKey="Thickness0" />
      <StaticResource x:Key="TabItemOuterBorderBrush" ResourceKey="Transparent" />
      <StaticResource x:Key="TabItemForegroundBrush" ResourceKey="ForegroundT85" />
      <StaticResource x:Key="TabItemInactiveForegroundBrush" ResourceKey="ForegroundT50" />
      <StaticResource x:Key="TabItemSelectedBackgroundBrush" ResourceKey="AccentButtonBackgroundBrush" />
      <StaticResource x:Key="TabItemSelectedInactiveBackgroundBrush" ResourceKey="SurfaceT19" />
      <StaticResource x:Key="TabItemSelectedForegroundBrush" ResourceKey="AccentForeground" />
      <StaticResource x:Key="TabItemSelectedInactiveForegroundBrush" ResourceKey="ForegroundT50" />
      <StaticResource x:Key="TabItemSelectedPressedBackgroundBrush" ResourceKey="AccentButtonPressedBackgroundBrush" />

      <StaticResource x:Key="TabItemVerticalSelectedBackgroundBrush" ResourceKey="TabItemSelectedBackgroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedInactiveBackgroundBrush" ResourceKey="TabItemSelectedInactiveBackgroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedForegroundBrush" ResourceKey="TabItemSelectedForegroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedInactiveForegroundBrush" ResourceKey="TabItemSelectedInactiveForegroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedPressedBackgroundBrush" ResourceKey="TabItemSelectedPressedBackgroundBrush" />

      <StaticResource x:Key="CheckBoxBackgroundBrush" ResourceKey="SurfaceT10" />
      <StaticResource x:Key="CheckBoxPressedBackgroundBrush" ResourceKey="SurfaceT19" />
      <StaticResource x:Key="CheckBoxCheckedBackgroundBrush" ResourceKey="SystemAccentD04" />
      <StaticResource x:Key="CheckBoxCheckedPressedBackgroundBrush" ResourceKey="SystemAccentH10" />
      <StaticResource x:Key="CheckBoxCheckedInactiveBackgroundBrush" ResourceKey="SurfaceT15" />
      <StaticResource x:Key="CheckBoxCheckedDisabledBackgroundBrush" ResourceKey="AccentBackgroundWash" />
      <StaticResource x:Key="CheckBoxCheckedDisabledInactiveBackgroundBrush" ResourceKey="SurfaceT08" />
      <StaticResource x:Key="CheckBoxDisabledBackgroundBrush" ResourceKey="SurfaceT05" />
      <StaticResource x:Key="CheckBoxCheckMarkBrush" ResourceKey="AccentForeground" />
      <StaticResource x:Key="CheckBoxDisabledCheckMarkBrush" ResourceKey="AccentForegroundT49" />
      <StaticResource x:Key="CheckBoxInactiveCheckMarkBrush" ResourceKey="ForegroundT85" />
      <StaticResource x:Key="CheckBoxDisabledInactiveCheckMarkBrush" ResourceKey="ForegroundT26" />
      <StaticResource x:Key="CheckBoxBoxShadow" ResourceKey="NoShadow" />

      <StaticResource x:Key="PopupBorderBrush" ResourceKey="ForegroundT20" />
      <StaticResource x:Key="ComboBoxItemPointerOverBackgroundBrush" ResourceKey="AccentHighlight" />

      <!--
        Declared per variant, not once at the dictionary root: a root-level StaticResource cannot see
        into ThemeDictionaries, so it silently binds the Default (light) AccentHighlight and dark
        menus end up wearing the light accent at the light opacity.

        Only the pointer-over state is accented. The :selected and :focus-visible states stay on the
        neutral brush so a submenu-open or keyboard-focused row remains distinguishable from the one
        under the pointer - see MenuResourceAliasBuilder.
      -->
      <StaticResource x:Key="MenuItemPointerOverBackgroundBrush" ResourceKey="AccentHighlight" />
      <!-- Sampled from a native menu whose submenu is open with the pointer elsewhere. -->
      <SolidColorBrush x:Key="PopupRowSelectedBackgroundBrush" Color="#d7d9d9" />
      <!-- Note: Shadow used to render a border on the _outside_ -->
      <StaticResource x:Key="ComboBoxBoxShadow" ResourceKey="TextBoxBoxShadow" />

      <StaticResource x:Key="TextBoxBorderBrush" ResourceKey="Transparent" />
      <BoxShadows x:Key="TextBoxBoxShadow">0 0 0 1 #0A000000</BoxShadows>

    </ResourceDictionary>

    <!-- MARK: Dark Mode -->

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="InputBackgroundColor">#20212e</Color>
      <SolidColorBrush x:Key="TextBoxMultiLineBackgroundBrush" Color="#1e1e1e" />

      <!-- OpaqueSurfaceTxx colours are used to fake the look of SurfaceTxx on standard backgrounds when true transparency doesn't work -->
      <SolidColorBrush x:Key="OpaqueSurfaceT08" Color="#323341" />

      <!--
        Opaque popup surface - see the light variant above for the rationale. Sampled straight from
        a native macOS dark menu, so it carries that material's slight cool cast rather than being a
        neutral grey.
      -->
      <SolidColorBrush x:Key="PopupSurface" Color="#22272a" />

      <SolidColorBrush x:Key="AccentBackgroundWash"
                       Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource DarkModeAccentBackgroundWashConverter}}"
                       Opacity="0.43" />
      <!-- Opaque - see the light variant above for why opacity cannot reach the target colour. -->
      <SolidColorBrush x:Key="AccentHighlight"
                       Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource DarkModeAccentHighlightConverter}}" />

      <!-- Generic resources shared across controls (use sparingly!) -->

      <SolidColorBrush x:Key="FocusBorderBrush" Color="{ReflectionBinding Color, Source={StaticResource SystemAccent}, Converter={StaticResource DarkModeFocusColorConverter}}"
                       Opacity="0.49" />
      <StaticResource x:Key="ControlLabelBrush" ResourceKey="ForegroundT85" />
      <StaticResource x:Key="ControlDisabledLabelBrush" ResourceKey="ForegroundT24" />

      <StaticResource x:Key="PopupBackgroundBrush" ResourceKey="PopupSurface" />
      <StaticResource x:Key="PopupInnerBorderHighlightBrush" ResourceKey="PopupBackgroundBrush" />

      <!-- Control-specific resources -->

      <StaticResource x:Key="ButtonBackgroundBrush" ResourceKey="SurfaceT08" />
      <StaticResource x:Key="ButtonBorderBrush" ResourceKey="Transparent" />
      <StaticResource x:Key="ButtonDisabledBackgroundBrush" ResourceKey="SurfaceT03" />
      <StaticResource x:Key="ButtonDisabledBorderBrush" ResourceKey="Transparent" />
      <StaticResource x:Key="ButtonPressedBackgroundBrush" ResourceKey="SurfaceT16" />
      <StaticResource x:Key="AccentButtonBackgroundBrush" ResourceKey="SystemAccent" />
      <StaticResource x:Key="AccentButtonInactiveBackgroundBrush" ResourceKey="ButtonBackgroundBrush" />
      <StaticResource x:Key="AccentButtonPressedBackgroundBrush" ResourceKey="SystemAccentH10" />
      <StaticResource x:Key="AccentButtonDisabledBorderBrush" ResourceKey="ButtonDisabledBorderBrush" />

      <StaticResource x:Key="TabControlTabstripBackgroundBrush" ResourceKey="OpaqueSurfaceT08" />

      <StaticResource x:Key="TabItemOuterBorderThickness" ResourceKey="Thickness0" />
      <StaticResource x:Key="TabItemOuterBorderBrush" ResourceKey="Transparent" />
      <StaticResource x:Key="TabItemForegroundBrush" ResourceKey="ForegroundT85" />
      <StaticResource x:Key="TabItemInactiveForegroundBrush" ResourceKey="ForegroundT50" />
      <StaticResource x:Key="TabItemSelectedBackgroundBrush" ResourceKey="AccentButtonBackgroundBrush" />
      <StaticResource x:Key="TabItemSelectedInactiveBackgroundBrush" ResourceKey="SurfaceT19" />
      <StaticResource x:Key="TabItemSelectedForegroundBrush" ResourceKey="AccentForeground" />
      <StaticResource x:Key="TabItemSelectedInactiveForegroundBrush" ResourceKey="ForegroundT50" />
      <StaticResource x:Key="TabItemSelectedPressedBackgroundBrush" ResourceKey="AccentButtonPressedBackgroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedBackgroundBrush" ResourceKey="TabItemSelectedBackgroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedInactiveBackgroundBrush" ResourceKey="TabItemSelectedInactiveBackgroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedForegroundBrush" ResourceKey="TabItemSelectedForegroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedInactiveForegroundBrush" ResourceKey="TabItemSelectedInactiveForegroundBrush" />
      <StaticResource x:Key="TabItemVerticalSelectedPressedBackgroundBrush" ResourceKey="TabItemSelectedPressedBackgroundBrush" />

      <StaticResource x:Key="CheckBoxBackgroundBrush" ResourceKey="SurfaceT10" />
      <StaticResource x:Key="CheckBoxPressedBackgroundBrush" ResourceKey="SurfaceT18" />
      <StaticResource x:Key="CheckBoxCheckedBackgroundBrush" ResourceKey="SystemAccentD03" />
      <StaticResource x:Key="CheckBoxCheckedPressedBackgroundBrush" ResourceKey="SystemAccentH13" />
      <StaticResource x:Key="CheckBoxCheckedInactiveBackgroundBrush" ResourceKey="SurfaceT14" />
      <StaticResource x:Key="CheckBoxCheckedDisabledBackgroundBrush" ResourceKey="AccentBackgroundWash" />
      <StaticResource x:Key="CheckBoxCheckedDisabledInactiveBackgroundBrush" ResourceKey="SurfaceT07" />
      <StaticResource x:Key="CheckBoxDisabledBackgroundBrush" ResourceKey="SurfaceT05" />
      <StaticResource x:Key="CheckBoxCheckMarkBrush" ResourceKey="AccentForeground" />
      <StaticResource x:Key="CheckBoxDisabledCheckMarkBrush" ResourceKey="AccentForegroundT51" />
      <StaticResource x:Key="CheckBoxInactiveCheckMarkBrush" ResourceKey="AccentForegroundT84" />
      <StaticResource x:Key="CheckBoxDisabledInactiveCheckMarkBrush" ResourceKey="AccentForegroundT25" />
      <StaticResource x:Key="CheckBoxBoxShadow" ResourceKey="NoShadow" />

      <StaticResource x:Key="PopupBorderBrush" ResourceKey="ForegroundT26" />
      <StaticResource x:Key="ComboBoxItemPointerOverBackgroundBrush" ResourceKey="AccentHighlight" />

      <!--
        Declared per variant, not once at the dictionary root: a root-level StaticResource cannot see
        into ThemeDictionaries, so it silently binds the Default (light) AccentHighlight and dark
        menus end up wearing the light accent at the light opacity.

        Only the pointer-over state is accented. The :selected and :focus-visible states stay on the
        neutral brush so a submenu-open or keyboard-focused row remains distinguishable from the one
        under the pointer - see MenuResourceAliasBuilder.
      -->
      <StaticResource x:Key="MenuItemPointerOverBackgroundBrush" ResourceKey="AccentHighlight" />
      <SolidColorBrush x:Key="PopupRowSelectedBackgroundBrush" Color="#3d4243" />
      <!-- Note: Shadow used to render a border on the _outside_ -->
      <StaticResource x:Key="ComboBoxBoxShadow" ResourceKey="TextBoxBoxShadow" />

      <!-- TextBoxBackgroundBrush is overridden at runtime by WallpaperTintApplier with a tint derived from the dominant colour of the current wallpaper.  
           See Internal/WallpaperTintApplier.cs → Apply().  (On non-MacOS devices or during Visual Regression testing, this mechanism is disabled and
           falls back to the regular TextBoxBackgroundBrush from ThemeResources.axaml) -->
      <StaticResource x:Key="TextBoxBorderBrush" ResourceKey="Transparent" />
      <BoxShadows x:Key="TextBoxBoxShadow">0 0 0 1 #0AFFFFFF</BoxShadows>

    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- MARK: Common Resources -->

  <x:Boolean x:Key="IsLiquidGlassTheme">True</x:Boolean>
  <x:Boolean x:Key="IsClassicTheme">False</x:Boolean>

  <StaticResource x:Key="ButtonBorderBoxShadow" ResourceKey="NoShadow" />
  <StaticResource x:Key="ButtonBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="ButtonMinHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="ButtonCornerRadius" ResourceKey="Radius6" />
  <StaticResource x:Key="ButtonPadding" ResourceKey="ThicknessL12R11" />

  <!-- TabControl & TabItem -->
  <Thickness x:Key="TabControlBorderThickness">0</Thickness>
  <Thickness x:Key="TabControlTabStripBorderThickness">0</Thickness>
  <!-- Base positioning is "2 0 0 0"; +6 all round re-insets tabs against
       PART_TabHeaderScrollViewer's -6 margin so the in-template TabItem focus ring has slack
       (the scroll viewer drops its own right slack when the overflow buttons show). -->
  <Thickness x:Key="TabControlTopItemsPresenterMargin">8 6 6 6</Thickness>
  <BoxShadows x:Key="TabControlScrollButtonBoxShadow">-1 0 4 0 #40000000</BoxShadows>
  <StaticResource x:Key="TabItemDividerBorderBrush" ResourceKey="SurfaceT10" />
  <Thickness x:Key="TabItemPadding">16 4</Thickness>
  <x:Double x:Key="TabItemDividerHeight">14</x:Double>

  <StaticResource x:Key="CheckBoxCornerRadius" ResourceKey="Radius5" />
  <StaticResource x:Key="CheckBoxBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="CheckBoxSize" ResourceKey="ControlSize16" />
  <StaticResource x:Key="CheckBoxCheckMarkSize" ResourceKey="ControlSize10" />
  <StaticResource x:Key="CheckBoxIndeterminateMarkWidth" ResourceKey="ControlSize9" />
  <StaticResource x:Key="CheckBoxIndeterminateMarkHeight" ResourceKey="ControlSize3" />

  <StaticResource x:Key="RadioButtonBackgroundBrush" ResourceKey="CheckBoxBackgroundBrush" />
  <StaticResource x:Key="RadioButtonPressedBackgroundBrush" ResourceKey="CheckBoxPressedBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckedBackgroundBrush" ResourceKey="CheckBoxCheckedBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckedPressedBackgroundBrush" ResourceKey="CheckBoxCheckedPressedBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckedInactiveBackgroundBrush" ResourceKey="CheckBoxCheckedInactiveBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckedDisabledBackgroundBrush" ResourceKey="CheckBoxCheckedDisabledBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckedDisabledInactiveBackgroundBrush" ResourceKey="CheckBoxCheckedDisabledInactiveBackgroundBrush" />
  <StaticResource x:Key="RadioButtonDisabledBackgroundBrush" ResourceKey="CheckBoxDisabledBackgroundBrush" />
  <StaticResource x:Key="RadioButtonCheckMarkBrush" ResourceKey="CheckBoxCheckMarkBrush" />
  <StaticResource x:Key="RadioButtonDisabledCheckMarkBrush" ResourceKey="CheckBoxDisabledCheckMarkBrush" />
  <StaticResource x:Key="RadioButtonInactiveCheckMarkBrush" ResourceKey="CheckBoxInactiveCheckMarkBrush" />
  <StaticResource x:Key="RadioButtonDisabledInactiveCheckMarkBrush" ResourceKey="CheckBoxDisabledInactiveCheckMarkBrush" />
  <StaticResource x:Key="RadioButtonBoxShadow" ResourceKey="NoShadow" />

  <StaticResource x:Key="RadioButtonCornerRadius" ResourceKey="Radius8" />
  <StaticResource x:Key="RadioButtonBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="RadioButtonSize" ResourceKey="ControlSize16" />
  <StaticResource x:Key="RadioButtonCheckMarkSize" ResourceKey="ControlSize5" />

  <!-- ComboBox -->
  <StaticResource x:Key="ComboBoxMinHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="ComboBoxBackgroundBrush" ResourceKey="ButtonBackgroundBrush" />
  <StaticResource x:Key="ComboBoxPressedBackgroundBrush" ResourceKey="ButtonPressedBackgroundBrush" />
  <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Transparent" />
  <StaticResource x:Key="ComboBoxBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="PopupCornerRadius" ResourceKey="Radius12" />


  <!-- ComboBox Button (ToggleButton) -->
  <StaticResource x:Key="ComboBoxButtonBackgroundBrush" ResourceKey="Transparent" />
  <StaticResource x:Key="ComboBoxButtonInactiveBackgroundBrush" ResourceKey="Transparent" />
  <StaticResource x:Key="ComboBoxButtonBorderBrush" ResourceKey="Transparent" />
  <StaticResource x:Key="ComboBoxButtonInactiveBorderBrush" ResourceKey="Transparent" />
  <StaticResource x:Key="ComboBoxButtonBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="ComboBoxChevronBrush" ResourceKey="ControlLabelBrush" />
  <StaticResource x:Key="ComboBoxChevronInactiveBrush" ResourceKey="ControlLabelBrush" />

  <!-- ComboBoxItem -->
  <StaticResource x:Key='ComboBoxItemCornerRadius' ResourceKey='Radius7' />
  <Thickness x:Key="ComboBoxItemPadding">5 4</Thickness>
  <x:Int32 x:Key="ComboBoxItemHeight">24</x:Int32>

  <!-- Popup -->
  <Thickness x:Key="PopupMargin">12 4 12 29</Thickness> <!-- to accommodate shadow -->
  <Thickness x:Key="PopupInnerBorderThickness">1 1 0 0</Thickness>
  <!--
    The drop-down list inset, matching the 4pt the menus use so every popup surface reads the same.
    Three tokens stack up to it, which is why the numbers look arbitrary:
      PopupInnerBorderThickness  1 1 0 0   top/left-only bevel
      PopupPadding               1 3 2 4   this key
      ComboBoxItemMargin         2 0       carried by the row itself
    left 1+1+2, top 1+3+0, right 0+2+2, bottom 0+4+0 - an even 4 on every side.

    InitialFirstItemDistance must track PopupPadding.Top (see ThemeResources.axaml): it positions a
    ComboBox popup so the selected row lands over the closed control. ComboBox and MultiComboBox read
    it through DynamicResource so this override actually reaches them.
  -->
  <Thickness x:Key="PopupPadding">1 3 2 4</Thickness>
  <x:Int32 x:Key="InitialFirstItemDistance">7</x:Int32>
  <!-- PopupMargin is "12 4 12 29" here, 3pt taller than classic's, so the trim follows it. -->
  <x:Int32 x:Key="PopupTrimHeight">33</x:Int32>
  <x:Double x:Key="SubMenuPopupVerticalOffset">-11</x:Double>

  <!--
    Menu surface insets. Native macOS 26 menus inset the selected row by 4pt from the menu
    background on every side, inside the menu's own 12pt corner. Ours sat at 6pt with a 4pt radius,
    which reads as too much air around a corner that is too tight.

    The 4pt inset is measured from Finder. The 7pt radius is not: measurement of a native menu puts
    it nearer 6pt, but 7pt is what looks right against our 12pt menu corner, so it was chosen by eye
    and should stay a judgement call rather than being "corrected" back to the measured value.

    The inset is not a single value. Horizontally it is PopupInnerBorderThickness + MenuFlyoutPadding;
    vertically it is PopupInnerBorderThickness + MenuFlyoutScrollerMargin. PopupInnerBorderThickness
    is "1 1 0 0" - a top/left-only bevel - so the padding and margin have to give that pixel back on
    those two sides for the visible gap to come out even at 4pt. Hence the asymmetric values below;
    they are not arbitrary, and a symmetric pair lands 1pt out on the top and left.

    MenuSelectionCornerRadius exists because the generic SelectionCornerRadius is shared with
    ComboBox, which should keep its own radius. Classic defines neither key and falls through to the
    MacOsMenu* defaults in Accents/MenuResources.axaml, so it is unaffected.
  -->
  <Thickness x:Key="MenuFlyoutPadding">3 0 4 0</Thickness>
  <Thickness x:Key="MenuFlyoutScrollerMargin">0 3 0 4</Thickness>
  <CornerRadius x:Key="MenuSelectionCornerRadius">7</CornerRadius>

  <!-- MenuItem -->
  <Thickness x:Key="MenuItemPadding">9 4 7 4</Thickness>
  <x:Double x:Key="MenuItemMinHeight">24</x:Double>


  <!-- TextBox -->
  <StaticResource x:Key="TextBoxMinDimensions" ResourceKey="ControlSize24" />
  <StaticResource x:Key="MultiComboBoxMinHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="TagInputMinHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="EditableComboBoxMinHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="EditableComboBoxHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="CalendarControlHeight" ResourceKey="ControlSize24" />
  <StaticResource x:Key="TextBoxCornerRadius" ResourceKey="ButtonCornerRadius" />
  <!-- Use BoxShadow instead of BorderThickness for LiquidGlass to ensure border is drawn "outside" 
       and avoids anti-aliasing artifacts with semi-transparent borders overlapping TextBox background -->
  <StaticResource x:Key="TextBoxBorderThickness" ResourceKey="Thickness0" />
  <Thickness x:Key="TextBoxPadding">3 0</Thickness>
  <x:Boolean x:Key="TextBoxBottomBorderIsVisible">False</x:Boolean>
  <x:Boolean x:Key="TextBoxBottomBorderShadowIsVisible">False</x:Boolean>
  <Thickness x:Key="TextBoxInnerDockPanelMargin">2</Thickness>
  <Thickness x:Key="TextBoxScrollViewerMargin">0 0 -3 0</Thickness><Thickness x:Key="TextBoxScrollPanelMargin">0 0 3 0</Thickness>
  <Thickness x:Key="TextBoxScrollBarMargin">0 -1 0 1</Thickness>

  <!-- ScrollBar -->
  <x:Double x:Key="ScrollBarSize">11</x:Double>
  <x:Double x:Key="ScrollBarExpandedThumbWidth">11</x:Double>
  <x:Double x:Key="ScrollBarExpandedStaticThumbWidth">11</x:Double>
  <Thickness x:Key="ScrollBarMargin">2</Thickness>
  <StaticResource x:Key="ScrollBarTrackBrush" ResourceKey="SurfaceT05" />
  <SolidColorBrush x:Key="ScrollBarTrackSeparatorBrush" Color="Transparent" />
  <StaticResource x:Key="ScrollBarTrackBorderThickness" ResourceKey="Thickness0" />
  <StaticResource x:Key="ScrollBarThumbBrush" ResourceKey="ForegroundT50" />
  <x:Double x:Key="ScrollBarThumbOpacity">1</x:Double>
  <CornerRadius x:Key="ScrollBarThumbCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ScrollBarTrackCornerRadius">6</CornerRadius>

  <!-- DEVELOPMENT ONLY -->

  <SolidColorBrush x:Key="SampleAppBackground" Color="{DynamicResource SystemRegionColor}" Opacity="0.8" />

  <!-- Custom wallpaper colours for testing transparency issues -->
  <SolidColorBrush x:Key="PreviewCustomWallpaperLight" Color="White" />
  <SolidColorBrush x:Key="PreviewCustomWallpaperDark" Color="Black" />

</ResourceDictionary>