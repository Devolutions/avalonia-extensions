<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SampleApp.ViewModels"
             x:Class="SampleApp.DemoPages.ColumnSearchAdornment"
             x:DataType="vm:ColumnSearchViewModel"
             VerticalAlignment="Stretch"
             DevoTreeDataGridExtensions.FillsHeaderWidth="{Binding IsEditing}">

  <UserControl.Styles>
    <!-- Magnifier glyph drawn from primitives, so the demo needs no icon asset. -->
    <Style Selector="Panel.magnifier">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.magnifier > Ellipse">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Panel.magnifier > Rectangle">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="1.2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="Button.affordance">
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.committed">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4 1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The field should read as the header cell itself, so it carries no chrome of its own: no border,
         no background, and no focus ring. -->
    <Style Selector="TextBox.header-search">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Padding" Value="4 0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.header-search /template/ Border">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Idle: magnifier only, and only while the header is hovered. -->
    <!-- The 8px lead keeps the affordance clear of the sort indicator, which the theme parks immediately
         to its left; the 2px trail keeps it off the column separator. -->
    <Button Name="PART_SearchButton"
            Classes="affordance"
            Margin="8 0 2 0"
            Command="{Binding BeginEditCommand}"
            ToolTip.Tip="Search this column"
            IsVisible="{AndBinding
                          {Binding !IsEditing},
                          {Binding !HasTerm},
                          {Binding $parent[TreeDataGridColumnHeader].IsPointerOver}
                        }">
      <Panel Classes="magnifier">
        <Ellipse Stroke="{Binding $parent[TreeDataGridColumnHeader].Foreground}" />
        <Rectangle Fill="{Binding $parent[TreeDataGridColumnHeader].Foreground}" />
      </Panel>
    </Button>

    <!-- Searched: the committed term. Clicking it reopens the field. -->
    <Button Name="PART_CommittedButton"
            Classes="affordance"
            Padding="0"
            Margin="8 0 2 0"
            Command="{Binding BeginEditCommand}"
            ToolTip.Tip="Edit this column's search"
            IsVisible="{AndBinding {Binding HasTerm}, {Binding !IsEditing}}">
      <Border Classes="committed">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Panel Classes="magnifier">
            <Ellipse Stroke="White" />
            <Rectangle Fill="White" />
          </Panel>
          <TextBlock Text="{Binding Term}"
                     Foreground="White"
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Button>

    <!-- Editing: a field spanning the whole header, with a clear button once there is something to clear. -->
    <DockPanel Name="PART_Editor" LastChildFill="True" IsVisible="{Binding IsEditing}">
      <Button DockPanel.Dock="Right"
              Classes="affordance"
              Content="✕"
              FontSize="11"
              Command="{Binding ClearCommand}"
              ToolTip.Tip="Clear this column's search"
              IsVisible="{Binding Draft, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBox Name="PART_SearchBox"
               Classes="header-search borderless no-focus-border"
               Text="{Binding Draft}"
               Watermark="{Binding Watermark}"
               FontSize="12"
               VerticalAlignment="Stretch"
               VerticalContentAlignment="Center">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>
  </Panel>
</UserControl>
