<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="MenuItem Svg">
    <Setter Property="Css" Value="{DynamicResource MacOsMenuSvgItemDefaultCss}" />
  </Style>

  <Style Selector="MenuItem:pointerover Svg">
    <Setter Property="Css" Value="{DynamicResource MacOsMenuSvgItemPointerOverCss}" />
  </Style>

  <Style Selector="MenuItem Svg:disabled">
    <Setter Property="Css" Value="{DynamicResource MacOsMenuSvgItemDisabledCss}" />
  </Style>
</Styles>
