<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="MenuFlyoutPresenter MenuItem Svg">
    <Setter Property="Css" Value="{DynamicResource MenuFlyoutItemIconCss}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem Svg:disabled">
    <Setter Property="Css" Value="{DynamicResource MenuFlyoutItemIconDisabledCss}"/>
  </Style>
</Styles>
