<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SampleApp.ViewModels"
             xmlns:pages="using:SampleApp.DemoPages"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="SampleApp.DemoPages.TreeDataGridColumnSearchDemo"
             x:DataType="vm:TreeDataGridColumnSearchViewModel">

  <Design.DataContext>
    <vm:TreeDataGridColumnSearchViewModel />
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="10" Margin="0 0 0 16">
      <TextBlock Text="In-column search" Classes="section-title" FontSize="18" />

      <TextBlock TextWrapping="Wrap"
                 Text="Hover a searchable column header (Name, Type, Status) to reveal a magnifier. Click it and the header turns into a search field spanning the column; press Enter to commit, Escape to cancel, or use ✕ to clear. A committed term stays visible in the header, to the right of the sort indicator, and clicking it reopens the field." />

      <TextBlock TextWrapping="Wrap"
                 FontWeight="SemiBold"
                 Text="Those three columns are Auto-sized. Their widths must not shift as the magnifier, the field or the committed term appear — the adornment is measured but excluded from the header's desired width. Sorting still works: click a header away from the search affordance." />

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Clear all searches" Command="{Binding ClearAllCommand}" />
        <TextBlock Text="{Binding MatchSummary}" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Text="{Binding ActiveTerms}" VerticalAlignment="Center" Opacity="0.7" FontStyle="Italic" />
      </StackPanel>
    </StackPanel>

    <TreeDataGrid ItemsSource="{Binding VisibleNodes}"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  VerticalAlignment="Top"
                  MaxHeight="320">

      <TreeDataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto">
        <DevoTreeDataGridExtensions.HeaderAdornment>
          <pages:ColumnSearchAdornment DataContext="{Binding NameSearch}" />
        </DevoTreeDataGridExtensions.HeaderAdornment>
      </TreeDataGridTextColumn>

      <TreeDataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto">
        <DevoTreeDataGridExtensions.HeaderAdornment>
          <pages:ColumnSearchAdornment DataContext="{Binding TypeSearch}" />
        </DevoTreeDataGridExtensions.HeaderAdornment>
      </TreeDataGridTextColumn>

      <TreeDataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="140" />

      <TreeDataGridTextColumn Header="Status of the item" Binding="{Binding Status}" Width="Auto">
        <DevoTreeDataGridExtensions.HeaderAdornment>
          <pages:ColumnSearchAdornment DataContext="{Binding StatusSearch}" />
        </DevoTreeDataGridExtensions.HeaderAdornment>
      </TreeDataGridTextColumn>

      <TreeDataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" />
    </TreeDataGrid>
  </DockPanel>
</UserControl>
