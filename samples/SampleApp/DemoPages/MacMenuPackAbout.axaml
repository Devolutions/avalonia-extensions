<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ext="clr-namespace:SampleApp.MarkupExtensions"
             xmlns:demo="clr-namespace:SampleApp.DemoPages"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="SampleApp.DemoPages.MacMenuPackAbout">

  <StackPanel Margin="10" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Classes="h1">About MacOS Menu Pack</TextBlock>

    <TextBlock FontSize="15" TextWrapping="Wrap">
      The MacOS Menu Pack is an externally consumable style pack for menu-related controls. It lets apps use platform-specific menu chrome even in otherwise custom branded areas.
    </TextBlock>

    <TextBlock FontSize="15" TextWrapping="Wrap">
      The pages in this section load the MenuPack on top of the currently selected theme (must be or contain Fluent), to demonstrate how MacOS menu styles can be applied over any Fluent-based host theme.
    </TextBlock>

    <TextBlock FontSize="15" TextWrapping="Wrap">
      Unlike the other menu packs, the MacOS pack needs to detect the macOS version in order to apply the matching classic / LiquidGlass styles. So a plain <TextBlock Classes="code">StyleInclude</TextBlock> does not suffice here.
    </TextBlock>

    <TextBlock Classes="section-title">Menu pack styles URI</TextBlock>
    <TextBlock FontFamily="{DynamicResource CodeFontFamily}"
               Text="avares://Devolutions.AvaloniaTheme.MacOS/Controls/MenuPack.styles.axaml"
               TextWrapping="Wrap" />

    <TextBlock Classes="section-title">Minimal usage</TextBlock>
    <TextBlock Classes="code"
               HorizontalAlignment="Left"
               LineHeight="18"
               Margin="5 -5 0 0"
               Padding="5 8 6 8">
      <TextBlock.Inlines>
        <Run Text="&lt;Application xmlns:macos=&quot;clr-namespace:Devolutions.AvaloniaTheme.MacOS.Controls;assembly=Devolutions.AvaloniaTheme.MacOS&quot; ...&gt;&#x0a;" />
        <Run Text="  &lt;Application.Styles&gt;&#x0a;" />
        <Run Text="    &lt;FluentTheme /&gt;&#x0a;" />
        <Run Text="    &lt;macos:MacOsMenuPack /&gt;&#x0a;" />
        <Run Text="  &lt;/Application.Styles&gt;&#x0a;" />
        <Run Text="&lt;/Application&gt;" />
      </TextBlock.Inlines>
    </TextBlock>

    <TextBlock Classes="h1" Margin="0 20 0 0">Isolation Demo</TextBlock>

    <Border x:Name="SimpleThemePrerequisiteNote"
            IsVisible="{ext:ThemeIsOneOf 'Simple'}"
            Padding="12"
            CornerRadius="6"
            BorderBrush="{DynamicResource LayoutBorderMidBrush}"
            BorderThickness="1"
            Background="{DynamicResource LayoutBackgroundLowBrush}">
      <TextBlock TextWrapping="Wrap">
        MenuPack demos require Fluent or a Fluent-based theme. The Simple theme is not supported because MenuPack depends on Fluent menu infrastructure.
      </TextBlock>
    </Border>

    <StackPanel x:Name="SupportedDemoRoot"
                IsVisible="{ext:ThemeIsOneOf 'Fluent, MacClassic, LiquidGlass, DevExpress, Linux, WinUI'}"
                Spacing="14">
      <demo:MenuPackIsolationDemoContent />
    </StackPanel>
  </StackPanel>
</UserControl>
