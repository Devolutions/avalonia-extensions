<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:internal="clr-namespace:Devolutions.AvaloniaTheme.WinUI.Internal">

  <!-- ListBox retains Avalonia selection behavior and uses WinUI ListView visuals. -->
  <Thickness x:Key="ListBoxItemPadding">16,0,12,0</Thickness>
  <x:Double x:Key="ListViewItemMinHeight">40</x:Double>
  <x:Double x:Key="ListViewItemMinWidth">88</x:Double>
  <CornerRadius x:Key="ListViewItemCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="ListViewItemSelectionIndicatorCornerRadius">1.5</CornerRadius>

  <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox"
                BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="{DynamicResource ListBoxBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource ListBoxForeground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ListBoxBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="internal:ListBoxScrollBehavior.IsEnabled" Value="True"/>
    <!-- Observe the realized WrapPanel so bound orientations and panel replacement stay in sync. -->
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
            Value="{Binding (internal:ListBoxScrollBehavior.RealizedWrapPanel).Orientation, RelativeSource={RelativeSource Self}, Converter={x:Static internal:ListBoxConverters.HorizontalScrollBarVisibility}, FallbackValue=Disabled}"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
            Value="{Binding (internal:ListBoxScrollBehavior.RealizedWrapPanel).Orientation, RelativeSource={RelativeSource Self}, Converter={x:Static internal:ListBoxConverters.VerticalScrollBarVisibility}, FallbackValue=Auto}"/>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForeground}"/>
    <Setter Property="Padding" Value="{DynamicResource ListBoxItemPadding}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ListViewItemMinHeight}"/>
    <Setter Property="MinWidth" Value="{DynamicResource ListViewItemMinWidth}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ListViewItemCornerRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Backplate"
                  Margin="4,2"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          <Border Name="SelectionIndicator"
                  IsHitTestVisible="False"
                  IsVisible="False"
                  Width="3"
                  Margin="4,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  CornerRadius="{DynamicResource ListViewItemSelectionIndicatorCornerRadius}"
                  Background="{DynamicResource ListViewItemSelectionIndicatorBrush}"/>
          <Border Name="FocusOuter"
                  IsHitTestVisible="False"
                  IsVisible="False"
                  Margin="1"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource ListViewItemFocusVisualPrimaryBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}"/>
          <Border Name="FocusInner"
                  IsHitTestVisible="False"
                  IsVisible="False"
                  Margin="3"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ListViewItemFocusVisualSecondaryBrush}"
                  CornerRadius="2"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Backplate">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPointerOver}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#Backplate">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundPressed}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#Backplate">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelected}"/>
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#Backplate">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelectedPointerOver}"/>
    </Style>
    <Style Selector="^:selected:pressed /template/ Border#Backplate">
      <Setter Property="Background" Value="{DynamicResource ListBoxItemBackgroundSelectedPressed}"/>
    </Style>
    <Style Selector="^:selected /template/ Border#SelectionIndicator">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^ /template/ Border#SelectionIndicator">
      <Setter Property="Height"
              Value="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static internal:ListBoxConverters.SelectionIndicatorHeight}}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#SelectionIndicator">
      <Setter Property="Height"
              Value="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static internal:ListBoxConverters.SelectionIndicatorPressedHeight}}"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusOuter, ^:focus-visible /template/ Border#FocusInner">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ListBoxItemForegroundDisabled}"/>
      <Style Selector="^ /template/ Border#Backplate">
        <Setter Property="Background" Value="{TemplateBinding Background}"/>
      </Style>
      <Style Selector="^:selected /template/ Border#Backplate">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelectedDisabled}"/>
      </Style>
      <Style Selector="^ /template/ Border#SelectionIndicator">
        <Setter Property="Background" Value="{DynamicResource ListViewItemSelectionIndicatorDisabledBrush}"/>
      </Style>
    </Style>
  </ControlTheme>

  <!-- Keep the named navigation variant compatible with the default leading indicator. -->
  <ControlTheme x:Key="WinUiNavItemTheme" TargetType="ListBoxItem"
                BasedOn="{StaticResource {x:Type ListBoxItem}}"/>

  <!-- Optional Segmented-style variant with a selected underline. -->
  <ControlTheme x:Key="WinUiSegmentItemTheme" TargetType="ListBoxItem"
                BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Style Selector="^:selected /template/ Border#SelectionIndicator">
      <Setter Property="Width" Value="NaN"/>
      <Setter Property="Height" Value="2"/>
      <Setter Property="CornerRadius" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Margin" Value="5,0,5,2"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#SelectionIndicator">
      <Setter Property="Height" Value="2"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
