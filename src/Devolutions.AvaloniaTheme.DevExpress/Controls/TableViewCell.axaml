<!-- Retrieved from Avalonia Fluent:
     https://github.com/AvaloniaUI/Avalonia/blob/27c1ece36cbe17de3b8f95ae88223ba68702ae47/src/Avalonia.Themes.Fluent/Controls/TableViewCell.xaml -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

  <Thickness x:Key="TableViewCellPadding">6,0</Thickness>

  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="{DynamicResource TableViewCellPadding}" />
  </ControlTheme>

</ResourceDictionary>
