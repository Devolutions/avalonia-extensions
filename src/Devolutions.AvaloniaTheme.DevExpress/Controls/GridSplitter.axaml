<!-- Source: https://github.com/AvaloniaUI/Avalonia/blob/27c1ece36cbe17de3b8f95ae88223ba68702ae47/src/Avalonia.Themes.Fluent/Controls/GridSplitter.xaml -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="MinWidth" Value="{DynamicResource GridSplitterThickness}" />
      <Setter Property="MinHeight" Value="{DynamicResource GridSplitterThickness}" />
      <Setter Property="Background" Value="{DynamicResource SystemAltMediumLowColor}" />
      <Setter Property="PreviewContent">
        <Template>
          <Rectangle Fill="{DynamicResource SystemAccentColor}" />
        </Template>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
</ResourceDictionary>
