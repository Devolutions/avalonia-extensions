<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ported from real WinUI: microsoft/microsoft-ui-xaml
       controls/dev/CommonStyles/CheckBox_themeresources.xaml (per-state resource-key aliases)
       and Common_themeresources_any.xaml (underlying Control*/Text*/Accent* tokens, shared via
       Accents/ThemeResources.axaml).

       Avalonia's Fluent CheckBox.xaml ControlTheme already has the same template-part shape as
       WinUI's (Border#PART_Border "capsule", Border#NormalRectangle glyph box, Path#CheckGlyph,
       plus Unchecked/Checked/Indeterminate state selectors), so this only overrides the
       ControlTheme's Setters/nested Styles — no template replacement needed. Real WinUI's outer
       "capsule" (PART_Border) is always fully transparent regardless of state, so it's set once
       at the top instead of being repeated per state. -->

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox"
                BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Foreground"  Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Background"  Value="{DynamicResource ControlFillColorTransparentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}"/>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
    </Style>

    <!-- Unchecked: glyph box outline + fill (glyph itself is invisible in this state) -->
    <Style Selector="^ /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
      <Setter Property="Background"  Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
      <Setter Property="Background"  Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}"/>
      <Setter Property="Background"  Value="{DynamicResource ControlAltFillColorQuarternaryBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}"/>
      <Setter Property="Background"  Value="{DynamicResource ControlAltFillColorDisabledBrush}"/>
    </Style>

    <!-- Checked/Indeterminate: glyph box + checkmark/dash glyph fill (WinUI uses identical
         values for Checked and Indeterminate in every state) -->
    <Style Selector="^:checked, ^:indeterminate">
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background"  Value="{DynamicResource ControlFillColorTransparentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlFillColorTransparentBrush}"/>
      </Style>
      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Background"  Value="{DynamicResource AccentFillColorDefaultBrush}"/>
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
      </Style>

      <Style Selector="^:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
        <Setter Property="Background"  Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
      </Style>

      <Style Selector="^:pressed /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
        <Setter Property="Background"  Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
      </Style>
      <Style Selector="^:pressed /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}"/>
      </Style>

      <Style Selector="^:disabled /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}"/>
        <Setter Property="Background"  Value="{DynamicResource AccentFillColorDisabledBrush}"/>
      </Style>
      <Style Selector="^:disabled /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}"/>
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>
